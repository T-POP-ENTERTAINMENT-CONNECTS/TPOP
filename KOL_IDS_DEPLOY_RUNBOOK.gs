function KOL_IDS_DEPLOY_FUNCTION_AUDIT(){
  var order=KOL_IDS_DEPLOY_RUN_ORDER(), all=[];
  order.forEach(function(s){s.functions.forEach(function(n){if(all.indexOf(n)<0)all.push(n);});});
  var missing=all.filter(function(n){return typeof globalThis[n]!=='function';});
  var result={success:missing.length===0,status:missing.length?'FAILED':'PASS',totalRequired:all.length,available:all.length-missing.length,missing:missing,stages:order.map(function(s){return {stage:s.stage,name:s.name,total:s.functions.length,missing:s.functions.filter(function(n){return typeof globalThis[n]!=='function';})};})};
  Logger.log(JSON.stringify(result,null,2));
  return result;
}
function KOL_IDS_DEPLOY_RUNBOOK_STATUS(){
  var audit=KOL_IDS_DEPLOY_FUNCTION_AUDIT();
  return {release:(typeof KOL_IDS_RELEASE_MANIFEST!=='undefined'?KOL_IDS_RELEASE_MANIFEST.RELEASE_ID:''),productVersion:(typeof KOL_IDS!=='undefined'?KOL_IDS.VERSION:''),cohesionRelease:'1.2.0.5',audit:audit};
}
